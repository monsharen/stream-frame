linux.release.x86_64 = "res://addons/mpv/bin/libstreamframe_mpv.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/mpv/bin/libstreamframe_mpv.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/mpv/bin/libstreamframe_mpv.linux.template_release.arm64.so"
